# This repository is often edited on Windows but every script here runs on
# Linux. A shell script committed with CRLF is not merely untidy: the kernel
# reads the shebang as "/bin/bash\r" and the script dies with
# "bad interpreter: No such file or directory". Same for the systemd units,
# cron files and fail2ban configs. Pin them all to LF in the working tree so
# that can never happen regardless of anyone's core.autocrlf setting.

* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.local     text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.example   text eol=lf

# Extensionless files that are still scripts/config
cron/*      text eol=lf
logrotate/* text eol=lf
LICENSE     text eol=lf
