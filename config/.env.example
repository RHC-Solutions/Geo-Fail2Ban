# ============================================================================
# Geo-Fail2Ban Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your API credentials.
# NEVER commit .env with real keys to git!
# install.sh copies it to /etc/geo-fail2ban.conf (chmod 600), which is what
# the scripts actually read at runtime.
# ============================================================================

# Telegram Bot Configuration
# Get these from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID_HERE"

# GeoIP Configuration (ipinfo.io)
# Get token from: https://ipinfo.io
# Free tier: 50,000 requests/month
IPINFO_API_TOKEN="YOUR_IPINFO_TOKEN_HERE"

# IP Reputation Configuration (AbuseIPDB)
# Get key from: https://www.abuseipdb.com
# Free tier: 1,000 checks+reports/day, 5 blacklist downloads/day
ABUSEIPDB_API_KEY="YOUR_ABUSEIPDB_KEY_HERE"

# AbuseIPDB Settings
ABUSE_THRESHOLD=75           # Confidence score (0-100) that triggers a PERMANENT ban
REPORT_CATEGORIES="18,22,23" # Categories reported back: 18=SSH Exploit, 22=Malware, 23=Spam
BLACKLIST_LIMIT=10000        # Max IPs fetched per daily blacklist import

# Geoblock: countries dropped entirely at the firewall (ipdeny.com codes).
# Used by ipset-geo/update.sh (daily auto-sync).
#
# TWO lists are applied, and GEOBLOCK_AFRICA is added ON TOP of
# GEOBLOCK_COUNTRIES - with the values shipped below that is 60 countries, not
# 7. Set a key to "" to block nothing from that list; remove the key entirely
# and update.sh falls back to these defaults. Removing a code from a list also
# removes it from the ipset on the next run.
GEOBLOCK_COUNTRIES="cn vn in bd pk ng ao"

# Whole-continent list. Set to "" if you do not want Africa blocked.
GEOBLOCK_AFRICA="dz ao bj bw bf bi cv cm cf td km cg cd ci dj eg gq er sz et ga gm gh gn gw ke ls lr ly mg mw ml mr mu ma mz na ne ng rw st sn sc sl so za ss sd tz tg tn ug eh zm zw"
