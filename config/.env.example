# ============================================================================
# Geo-Fail2Ban Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your API credentials
# NEVER commit .env file with real keys to git!
# ============================================================================

# Telegram Bot Configuration
# Get these from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID_HERE"

# GeoIP Configuration (ipinfo.io)
# Get token from: https://ipinfo.io
# Free tier: 50,000 requests/month
IPINFO_API_TOKEN="YOUR_IPINFO_TOKEN_HERE"

# IP Reputation Configuration (AbuseIPDB)
# Get key from: https://www.abuseipdb.com
# Free tier: 1,000 reports/day
ABUSEIPDB_API_KEY="YOUR_ABUSEIPDB_KEY_HERE"

# Server Configuration
SERVER_NAME="your-server-hostname"
SERVER_LOCATION="Datacenter Name"

# Fail2Ban Settings
BAN_TIME=86400              # Ban duration in seconds (86400 = 24 hours)
MAX_RETRIES=5               # Failed attempts before ban
FIND_TIME=3600              # Detection window in seconds (3600 = 1 hour)

# AbuseIPDB Settings
ABUSE_THRESHOLD=75          # Minimum abuse score to auto-block (0-100%)
REPORT_CATEGORIES="18,22,23" # Categories: 18=SSH Exploit, 22=Malware, 23=Spam
BLACKLIST_LIMIT=10000       # Max IPs to import per hour

# Email Configuration (Optional)
ENABLE_EMAIL_ALERTS=false
EMAIL_RECIPIENT="admin@example.com"
EMAIL_FROM="fail2ban@example.com"

# Logging
LOG_LEVEL="INFO"            # DEBUG, INFO, WARNING, ERROR
LOG_DIR="/var/log/fail2ban-geo"

# Advanced Settings
ENABLE_IPINFO_DETAILS=true  # Show detailed GeoIP info
ENABLE_TOR_DETECTION=true   # Detect Tor exit nodes
ENABLE_VPN_DETECTION=false  # Detect VPN usage
WHOIS_LOOKUP=true           # Include WHOIS data
