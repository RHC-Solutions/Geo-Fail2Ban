[Unit]
Description=Restore AbuseIPDB blacklist ipset and iptables rule at boot
DefaultDependencies=no
Before=ufw.service firewalld.service netfilter-persistent.service fail2ban.service network-pre.target
Wants=network-pre.target
ConditionPathExists=/etc/ipset-abuseipdb.conf

[Service]
Type=oneshot
RemainAfterExit=yes
# Resolved via PATH rather than hardcoded: ipset/iptables live in /usr/sbin on
# Debian/RHEL, /sbin on Alpine and /usr/bin on Arch.
ExecStart=/bin/sh -c 'exec ipset -exist restore -file /etc/ipset-abuseipdb.conf'
ExecStart=/bin/sh -c 'iptables -C INPUT -m set --match-set abuseipdb-blacklist src -j DROP 2>/dev/null || iptables -I INPUT 1 -m set --match-set abuseipdb-blacklist src -j DROP'
ExecStop=/bin/true

[Install]
WantedBy=multi-user.target
