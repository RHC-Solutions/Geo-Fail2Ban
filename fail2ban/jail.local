# Fail2ban main configuration with Telegram alerts
# Local configuration file

[DEFAULT]
# Default ban time (24 hours)
bantime = 86400

# Finding time (1 hour)
findtime = 3600

# Max retry attempts before ban
maxretry = 5

# Default action
action = %(action_)s
         telegram

banaction = iptables-multiport

[sshd]
enabled = true
port = ssh
filter = sshd
# Debian/Ubuntu default. install.sh rewrites this line to
# 'logpath = /var/log/secure' on RHEL/Fedora/SUSE, or to 'backend = systemd'
# on hosts that only log SSH to the journal. Adjust by hand if you install
# manually - the jail will not start if it points at a file that isn't there.
logpath = /var/log/auth.log
maxretry = 5
findtime = 3600
bantime = 86400
action = %(action_)s
         telegram
